 255:Src/usbd_cdc_if.c **** /**
 256:Src/usbd_cdc_if.c ****   * @brief  Data received over USB OUT endpoint are sent over CDC interface
 257:Src/usbd_cdc_if.c ****   *         through this function.
 258:Src/usbd_cdc_if.c ****   *
 259:Src/usbd_cdc_if.c ****   *         @note
 260:Src/usbd_cdc_if.c ****   *         This function will issue a NAK packet on any OUT packet received on
 261:Src/usbd_cdc_if.c ****   *         USB endpoint until exiting this function. If you exit this function
 262:Src/usbd_cdc_if.c ****   *         before transfer is complete on CDC interface (ie. using DMA controller)
 263:Src/usbd_cdc_if.c ****   *         it will result in receiving more data while previous ones are still
 264:Src/usbd_cdc_if.c ****   *         not sent.
 265:Src/usbd_cdc_if.c ****   *
 266:Src/usbd_cdc_if.c ****   * @param  Buf: Buffer of data to be received
 267:Src/usbd_cdc_if.c ****   * @param  Len: Number of data received (in bytes)
 268:Src/usbd_cdc_if.c ****   * @retval Result of the operation: USBD_OK if all operations are OK else USBD_FAIL
 269:Src/usbd_cdc_if.c ****   */
 270:Src/usbd_cdc_if.c **** static int8_t CDC_Receive_FS(uint8_t* Buf, uint32_t *Len)
 271:Src/usbd_cdc_if.c **** {
 272:Src/usbd_cdc_if.c ****   /* USER CODE BEGIN 6 */
