 222:Src/usbd_cdc_if.c ****   /*                                        2 - 2 Stop bits                      */
 223:Src/usbd_cdc_if.c ****   /* 5      | bParityType |  1   | Number | Parity                               */
 224:Src/usbd_cdc_if.c ****   /*                                        0 - None                             */
 225:Src/usbd_cdc_if.c ****   /*                                        1 - Odd                              */
 226:Src/usbd_cdc_if.c ****   /*                                        2 - Even                             */
 227:Src/usbd_cdc_if.c ****   /*                                        3 - Mark                             */
 228:Src/usbd_cdc_if.c ****   /*                                        4 - Space                            */
 229:Src/usbd_cdc_if.c ****   /* 6      | bDataBits  |   1   | Number Data bits (5, 6, 7, 8 or 16).          */
