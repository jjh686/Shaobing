  24:modules/BMI088/bmi088.c ****     static uint8_t rx[8]; // 前两个字节是dummy data,第三个开始是真正的数据
  25:modules/BMI088/bmi088.c ****     tx[0] = 0x80 | reg;   // 静态变量每次进来还是上次的值,所以要每次都要给tx[
