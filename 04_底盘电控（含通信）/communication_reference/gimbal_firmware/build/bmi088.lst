 105:modules/BMI088/bmi088.c **** /**
 106:modules/BMI088/bmi088.c ****  * @brief 初始化BMI088加速度计,提高可读性分拆功能
 107:modules/BMI088/bmi088.c ****  *
 108:modules/BMI088/bmi088.c ****  * @param bmi088 待初始化的BMI088实例
 109:modules/BMI088/bmi088.c ****  * @return uint8_t BMI088ERROR CODE if any problems here
 110:modules/BMI088/bmi088.c ****  */
 111:modules/BMI088/bmi088.c **** static uint8_t BMI088AccelInit(BMI088Instance *bmi088)
 112:modules/BMI088/bmi088.c **** {
 113:modules/BMI088/bmi088.c ****     uint8_t whoami_check = 0;
 114:modules/BMI088/bmi088.c **** 
 115:modules/BMI088/bmi088.c ****     // 加速度计以I2C模式启动,需要一次上升沿来切换到SPI模式,因此进行一次
 116:modules/BMI088/bmi088.c ****     BMI088AccelRead(bmi088, BMI088_ACC_CHIP_ID, &whoami_check, 1);
 117:modules/BMI088/bmi088.c ****     DWT_Delay(0.001);
 118:modules/BMI088/bmi088.c **** 
 119:modules/BMI088/bmi088.c ****     BMI088AccelWriteSingleReg(bmi088, BMI088_ACC_SOFTRESET, BMI088_ACC_SOFTRESET_VALUE); // 软复�
 120:modules/BMI088/bmi088.c ****     DWT_Delay(BMI088_COM_WAIT_SENSOR_TIME / 1000);
 121:modules/BMI088/bmi088.c **** 
 122:modules/BMI088/bmi088.c ****     // 检查ID,如果不是0x1E(bmi088 whoami寄存器值),则返回错误
 123:modules/BMI088/bmi088.c ****     BMI088AccelRead(bmi088, BMI088_ACC_CHIP_ID, &whoami_check, 1);
 124:modules/BMI088/bmi088.c ****     if (whoami_check != BMI088_ACC_CHIP_ID_VALUE)
 125:modules/BMI088/bmi088.c ****         return BMI088_NO_SENSOR;
 126:modules/BMI088/bmi088.c ****     DWT_Delay(0.001);
 127:modules/BMI088/bmi088.c ****     // 初始化寄存器,提高可读性
 128:modules/BMI088/bmi088.c ****     uint8_t reg = 0, data = 0;
 129:modules/BMI088/bmi088.c ****     BMI088_ERORR_CODE_e error = 0;
 130:modules/BMI088/bmi088.c ****     // 使用sizeof而不是magic number,这样如果修改了数组大小,不用修改这里的代
 131:modules/BMI088/bmi088.c ****     for (uint8_t i = 0; i < sizeof(BMI088_Accel_Init_Table) / sizeof(BMI088_Accel_Init_Table[0]); i
 132:modules/BMI088/bmi088.c ****     {
 133:modules/BMI088/bmi088.c ****         reg = BMI088_Accel_Init_Table[i][BMI088REG];
 134:modules/BMI088/bmi088.c ****         data = BMI088_Accel_Init_Table[i][BMI088DATA];
 135:modules/BMI088/bmi088.c ****         BMI088AccelWriteSingleReg(bmi088, reg, data); // 写入寄存器
 136:modules/BMI088/bmi088.c ****         DWT_Delay(0.01);
 137:modules/BMI088/bmi088.c ****         BMI088AccelRead(bmi088, reg, &data, 1); // 写完之后立刻读回检查
 138:modules/BMI088/bmi088.c ****         DWT_Delay(0.01);
 139:modules/BMI088/bmi088.c ****         if (data != BMI088_Accel_Init_Table[i][BMI088DATA])
 140:modules/BMI088/bmi088.c ****             error |= BMI088_Accel_Init_Table[i][BMI088ERROR];
 141:modules/BMI088/bmi088.c ****         //{i--;} 可以设置retry次数,如果retry次数用完了,则返回error
 142:modules/BMI088/bmi088.c ****     }
 143:modules/BMI088/bmi088.c ****     return error;
 144:modules/BMI088/bmi088.c **** }
