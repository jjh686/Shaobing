 165:bsp/can/bsp_can.c **** //外部调用的CAN发送函数，对比旧版进行了循环队列优化，防止while忙等导�
 166:bsp/can/bsp_can.c **** void CANTransmit(CANInstance *_instance, uint8_t length)
 167:bsp/can/bsp_can.c **** {
 168:bsp/can/bsp_can.c ****     if(_instance->can_handle == &hcan1){
 169:bsp/can/bsp_can.c ****         CANSendFIFOPut(_instance, &CAN1_Send_FIFO, length);// 将消息填入至队列中
 170:bsp/can/bsp_can.c ****         CANSendFIFOTransmit(&CAN1_Send_FIFO);// 触发一次发送，防止因消息队列临时为
 171:bsp/can/bsp_can.c ****     }else if(_instance->can_handle == &hcan2){
 172:bsp/can/bsp_can.c ****         CANSendFIFOPut(_instance, &CAN2_Send_FIFO, length);
 173:bsp/can/bsp_can.c ****         CANSendFIFOTransmit(&CAN2_Send_FIFO);
 174:bsp/can/bsp_can.c ****     }
 175:bsp/can/bsp_can.c **** }
