 271:modules/imu/ins_task.c ****  * @brief          Transform 3dvector from BodyFrame to EarthFrame
 272:modules/imu/ins_task.c ****  * @param[1]       vector in BodyFrame
 273:modules/imu/ins_task.c ****  * @param[2]       vector in EarthFrame
 274:modules/imu/ins_task.c ****  * @param[3]       quaternion
 275:modules/imu/ins_task.c ****  */
 276:modules/imu/ins_task.c **** void BodyFrameToEarthFrame(const float *vecBF, float *vecEF, float *q)
 277:modules/imu/ins_task.c **** {
 278:modules/imu/ins_task.c ****     vecEF[0] = 2.0f * ((0.5f - q[2] * q[2] - q[3] * q[3]) * vecBF[0] +
 279:modules/imu/ins_task.c ****                        (q[1] * q[2] - q[0] * q[3]) * vecBF[1] +
 280:modules/imu/ins_task.c ****                        (q[1] * q[3] + q[0] * q[2]) * vecBF[2]);
 281:modules/imu/ins_task.c **** 
 282:modules/imu/ins_task.c ****     vecEF[1] = 2.0f * ((q[1] * q[2] + q[0] * q[3]) * vecBF[0] +
 283:modules/imu/ins_task.c ****                        (0.5f - q[1] * q[1] - q[3] * q[3]) * vecBF[1] +
 284:modules/imu/ins_task.c ****                        (q[2] * q[3] - q[0] * q[1]) * vecBF[2]);
 285:modules/imu/ins_task.c **** 
 286:modules/imu/ins_task.c ****     vecEF[2] = 2.0f * ((q[1] * q[3] - q[0] * q[2]) * vecBF[0] +
 287:modules/imu/ins_task.c ****                        (q[2] * q[3] + q[0] * q[1]) * vecBF[1] +
 288:modules/imu/ins_task.c ****                        (0.5f - q[1] * q[1] - q[2] * q[2]) * vecBF[2]);
 289:modules/imu/ins_task.c **** }
 290:modules/imu/ins_task.c **** 
 291:modules/imu/ins_task.c **** /**
 292:modules/imu/ins_task.c ****  * @brief          Transform 3dvector from EarthFrame to BodyFrame
 293:modules/imu/ins_task.c ****  * @param[1]       vector in EarthFrame
