 157:modules/imu/ins_task.c **** static void PublishSample(void)
 158:modules/imu/ins_task.c **** {
 159:modules/imu/ins_task.c ****     INS_Snapshot_t sample = {0};
 160:modules/imu/ins_task.c ****     float norm = 0;
 161:modules/imu/ins_task.c ****     sample.valid = 1;
 162:modules/imu/ins_task.c ****     for (int i=0; i<4; ++i) {
 163:modules/imu/ins_task.c ****         if (!isfinite(INS.q[i])) sample.valid = 0;
 164:modules/imu/ins_task.c ****         norm += INS.q[i]*INS.q[i];
 165:modules/imu/ins_task.c ****     }
 166:modules/imu/ins_task.c ****     if (!isfinite(norm) || norm < 0.25f || norm > 2.25f) sample.valid = 0;
 167:modules/imu/ins_task.c ****     if (sample.valid) {
 168:modules/imu/ins_task.c ****         float scale = 1.0f / sqrtf(norm);
 169:modules/imu/ins_task.c ****         for (int i=0; i<4; ++i) sample.q[i] = INS.q[i]*scale;
 170:modules/imu/ins_task.c ****     }
 171:modules/imu/ins_task.c ****     for (int i=0; i<3; ++i) {
 172:modules/imu/ins_task.c ****         sample.gyro[i] = INS.Gyro[i];
 173:modules/imu/ins_task.c ****         sample.attitude.Gyro[i] = INS.Gyro[i];
 174:modules/imu/ins_task.c ****         sample.attitude.Accel[i] = INS.Accel[i];
 175:modules/imu/ins_task.c ****         if (!isfinite(INS.Gyro[i]) || !isfinite(INS.Accel[i])) sample.valid = 0;
 176:modules/imu/ins_task.c ****     }
 177:modules/imu/ins_task.c ****     sample.attitude.Yaw = INS.Yaw;
 178:modules/imu/ins_task.c ****     sample.attitude.Pitch = INS.Pitch;
 179:modules/imu/ins_task.c ****     sample.attitude.Roll = INS.Roll;
 180:modules/imu/ins_task.c ****     sample.attitude.YawTotalAngle = INS.YawTotalAngle;
 181:modules/imu/ins_task.c ****     sample.tick = HAL_GetTick();
 182:modules/imu/ins_task.c ****     uint32_t primask = __get_PRIMASK();
 183:modules/imu/ins_task.c ****     __disable_irq();
 184:modules/imu/ins_task.c ****     published_sample = sample;
 185:modules/imu/ins_task.c ****     attitude_data = sample.attitude;
 186:modules/imu/ins_task.c ****     __set_PRIMASK(primask);
 187:modules/imu/ins_task.c **** /* [USB_SP 修改 10 结束] */
 188:modules/imu/ins_task.c **** }
