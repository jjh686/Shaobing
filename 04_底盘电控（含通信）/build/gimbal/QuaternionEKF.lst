 163:modules/algorithm/QuaternionEKF.c ****                                         QEKF_INS.Gyro[2] * QEKF_INS.Gyro[2]);
 164:modules/algorithm/QuaternionEKF.c ****     QEKF_INS.accl_norm = 1.0f / accelInvNorm;
 165:modules/algorithm/QuaternionEKF.c **** 
