 136:bsp/can/bsp_can.c **** CANInstance *CANRegister(CAN_Init_Config_s *config)
 137:bsp/can/bsp_can.c **** {
 138:bsp/can/bsp_can.c ****     if (!idx)
 139:bsp/can/bsp_can.c ****     {
 140:bsp/can/bsp_can.c ****         CANServiceInit(); // 第一次注册,先进行硬件初始化
 141:bsp/can/bsp_can.c ****         LOGINFO("[bsp_can] CAN Service Init");
 142:bsp/can/bsp_can.c ****     }
 143:bsp/can/bsp_can.c ****     if (idx >= CAN_MX_REGISTER_CNT) // 超过最大实例数
 144:bsp/can/bsp_can.c ****     {
 145:bsp/can/bsp_can.c ****         while (1)
 146:bsp/can/bsp_can.c ****             LOGERROR("[bsp_can] CAN instance exceeded MAX num, consider balance the load of CAN bus
 147:bsp/can/bsp_can.c ****     }
 148:bsp/can/bsp_can.c ****     for (size_t i = 0; i < idx; i++)
 149:bsp/can/bsp_can.c ****     { // 重复注册 | id重复
 150:bsp/can/bsp_can.c ****         if (can_instance[i]->rx_id == config->rx_id && can_instance[i]->can_handle == config->can_h
 151:bsp/can/bsp_can.c ****         {
 152:bsp/can/bsp_can.c ****             while (1)
 153:bsp/can/bsp_can.c ****                 LOGERROR("[bsp_can] CAN id crash ,tx [%d] or rx [%d] already registered", config->t
 154:bsp/can/bsp_can.c ****         }
 155:bsp/can/bsp_can.c ****     }
 156:bsp/can/bsp_can.c ****     
 157:bsp/can/bsp_can.c ****     CANInstance *instance = (CANInstance *)malloc(sizeof(CANInstance)); // 分配空间
 158:bsp/can/bsp_can.c ****     memset(instance, 0, sizeof(CANInstance));                           // 分配的空间未必是
 159:bsp/can/bsp_can.c ****     // 设置回调函数和接收发送id
 160:bsp/can/bsp_can.c ****     instance->can_handle = config->can_handle;
 161:bsp/can/bsp_can.c ****     instance->tx_id = config->tx_id;
