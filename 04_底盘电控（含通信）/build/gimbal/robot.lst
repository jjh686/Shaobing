 132:application/robot_task.h **** __attribute__((noreturn)) void StartROBOTTASK(void const *argument)
 133:application/robot_task.h **** {
 134:application/robot_task.h ****     static float robot_dt;
 135:application/robot_task.h ****     static float robot_start;
 136:application/robot_task.h ****     LOGINFO("[freeRTOS] ROBOT core Task Start");
 137:application/robot_task.h ****     // 200Hz-500Hz,若有额外的控制任务如平衡步兵可能需要提升至1kHz
 138:application/robot_task.h ****     for (;;)
ARM GAS  /tmp/ccgeX1ct.s 			page 8


 139:application/robot_task.h ****     {
 140:application/robot_task.h ****         robot_start = DWT_GetTimeline_ms();
 141:application/robot_task.h ****         RobotTask();
 142:application/robot_task.h ****         robot_dt = DWT_GetTimeline_ms() - robot_start;
 143:application/robot_task.h ****         if (robot_dt > 5)
 144:application/robot_task.h ****             LOGERROR("[freeRTOS] ROBOT core Task is being DELAY! dt = [%f]", &robot_dt);
 145:application/robot_task.h ****         osDelay(5);
 146:application/robot_task.h ****     }
 147:application/robot_task.h **** }
