   7:modules/master_machine/sp_protocol.c **** {
   8:modules/master_machine/sp_protocol.c ****     uint16_t crc = 0xffffu;
   9:modules/master_machine/sp_protocol.c ****     for (size_t i = 0; i < size; ++i) {
  10:modules/master_machine/sp_protocol.c ****         crc ^= data[i];
  11:modules/master_machine/sp_protocol.c ****         for (unsigned bit = 0; bit < 8; ++bit)
