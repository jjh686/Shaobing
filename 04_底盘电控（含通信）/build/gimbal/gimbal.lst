  61:application/gimbal/gimbal.c ****     if (!isfinite(mechanical_deg)) {
  62:application/gimbal/gimbal.c ****         output = NAN;
  63:application/gimbal/gimbal.c ****     } else if (isfinite(output)) {
  64:application/gimbal/gimbal.c ****         float encoder_effort = output * axis->pose_to_encoder_sign;
  65:application/gimbal/gimbal.c ****         if ((mechanical_deg >= axis->max_deg && encoder_effort > 0.0f) ||
  66:application/gimbal/gimbal.c ****             (mechanical_deg <= axis->min_deg && encoder_effort < 0.0f)) {
