  50:application/gimbal/gimbal.c ****         ? GimbalSpeedPiStep(pi, measure_rad_s, ref_rad_s, dt_s) : NAN;
  51:application/gimbal/gimbal.c **** 
  52:application/gimbal/gimbal.c ****     /* Limiting the angle target alone cannot prevent a retained I term from
  53:application/gimbal/gimbal.c ****      * pushing outward at a zero speed reference. Enforce the SAME startup
  54:application/gimbal/gimbal.c ****      * encoder envelope at the motor rate. Positive controller output means
  55:application/gimbal/gimbal.c ****      * positive pose; the existing pose->encoder sign maps that to mechanics.
  56:application/gimbal/gimbal.c ****      * The final configured actuator sign is still applied only by the driver. */
  57:application/gimbal/gimbal.c ****     uint32_t mask = __get_PRIMASK();
