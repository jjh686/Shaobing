 236:modules/remote/remote_control.c **** /* DMA/IDLE boundaries are not SBUS frame boundaries. Keep partial frames and
 237:modules/remote/remote_control.c ****  * slide to the next header after corruption. Real lost/failsafe bits stay fatal. */
 238:modules/remote/remote_control.c **** static void FS_RemoteControlRxCallback(void)
 239:modules/remote/remote_control.c **** {
 240:modules/remote/remote_control.c ****     fs_uart_fault();
