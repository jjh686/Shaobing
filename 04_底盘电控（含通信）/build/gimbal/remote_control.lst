 242:modules/remote/remote_control.c ****     if(fs_partial_len&&(uint32_t)(now-fs_partial_ms)>20u){
 243:modules/remote/remote_control.c ****         fs_partial_len=0;fs_sbus_diag.partial_timeouts++;fs_fault=1;++fs_fault_generation;
 244:modules/remote/remote_control.c ****     }
 245:modules/remote/remote_control.c ****     for(unsigned i=0;i<rc_usart_instance->recv_len;i++){
 246:modules/remote/remote_control.c ****         uint8_t byte=rc_usart_instance->recv_buff[i];
 247:modules/remote/remote_control.c ****         if(!fs_partial_len&&byte!=0x0f){fs_sbus_diag.discarded_bytes++;continue;}
 248:modules/remote/remote_control.c ****         fs_partial[fs_partial_len++]=byte;fs_partial_ms=now;
 249:modules/remote/remote_control.c ****         if(fs_partial_len!=SBUS_FRAME_SIZE)continue;
 250:modules/remote/remote_control.c ****         uint8_t tail_ok=fs_partial[24]==0||(fs_partial[24]&0x0f)==0x04;
 251:modules/remote/remote_control.c ****         if(tail_ok&&fs_accept_frame(fs_partial,now)){
 252:modules/remote/remote_control.c ****             fs_partial_len=0;
 253:modules/remote/remote_control.c ****         }else{
 254:modules/remote/remote_control.c ****             if(!tail_ok){fs_sbus_diag.bad_tail++;fs_fault=1;++fs_fault_generation;}
 255:modules/remote/remote_control.c ****             unsigned skip=1;while(skip<SBUS_FRAME_SIZE&&fs_partial[skip]!=0x0f)skip++;
 256:modules/remote/remote_control.c ****             fs_sbus_diag.discarded_bytes+=skip;fs_partial_len=SBUS_FRAME_SIZE-skip;
 257:modules/remote/remote_control.c ****             memmove(fs_partial,fs_partial+skip,fs_partial_len);
 258:modules/remote/remote_control.c ****         }
 259:modules/remote/remote_control.c ****     }
