 417:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *
 418:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *       _WriteNoCheck()
 419:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *
 420:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *  Function description
 421:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    Stores a specified number of characters in SEGGER RTT ring buffer
 422:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    and updates the associated write pointer which is periodically
 423:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    read by the host.
 424:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    It is callers responsibility to make sure data actually fits in buffer.
 425:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *
 426:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *  Parameters
 427:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    pRing        Ring buffer to post to.
 428:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    pBuffer      Pointer to character array. Does not need to point to a \0 terminated string.
 429:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    NumBytes     Number of bytes to be stored in the SEGGER RTT control block.
ARM GAS  /tmp/ccJkoA2o.s 			page 9


 430:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *
 431:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *  Notes
 432:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** *    (1) If there might not be enough space in the "Up"-buffer, call _WriteBlocking
 433:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** */
 434:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** static void _WriteNoCheck(SEGGER_RTT_BUFFER_UP* pRing, const char* pData, unsigned NumBytes) {
 435:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   unsigned NumBytesAtOnce;
 436:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   unsigned WrOff;
 437:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   unsigned Rem;
 438:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   volatile char* pDst;
 439:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** 
 440:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   WrOff = pRing->WrOff;
 441:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   Rem = pRing->SizeOfBuffer - WrOff;
 442:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   if (Rem > NumBytes) {
 443:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     //
 444:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     // All data fits before wrap around
 445:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     //
 446:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pDst = (pRing->pBuffer + WrOff) + SEGGER_RTT_UNCACHED_OFF;
 447:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 448:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     WrOff += NumBytes;
 449:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     while (NumBytes--) {
 450:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****       *pDst++ = *pData++;
 451:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     };
 452:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     RTT__DMB();                     // Force data write to be complete before writing the <WrOff>, 
 453:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pRing->WrOff = WrOff;
 454:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** #else
 455:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY((void*)pDst, pData, NumBytes);
 456:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     RTT__DMB();                     // Force data write to be complete before writing the <WrOff>, 
 457:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pRing->WrOff = WrOff + NumBytes;
 458:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** #endif
 459:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   } else {
 460:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     //
 461:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     // We reach the end of the buffer, so need to wrap around
 462:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     //
 463:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** #if SEGGER_RTT_MEMCPY_USE_BYTELOOP
 464:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pDst = (pRing->pBuffer + WrOff) + SEGGER_RTT_UNCACHED_OFF;
 465:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     NumBytesAtOnce = Rem;
 466:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     while (NumBytesAtOnce--) {
 467:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****       *pDst++ = *pData++;
 468:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     };
 469:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pDst = pRing->pBuffer + SEGGER_RTT_UNCACHED_OFF;
 470:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     NumBytesAtOnce = NumBytes - Rem;
 471:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     while (NumBytesAtOnce--) {
 472:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****       *pDst++ = *pData++;
 473:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     };
 474:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     RTT__DMB();                     // Force data write to be complete before writing the <WrOff>, 
 475:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pRing->WrOff = NumBytes - Rem;
 476:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** #else
 477:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     NumBytesAtOnce = Rem;
 478:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pDst = (pRing->pBuffer + WrOff) + SEGGER_RTT_UNCACHED_OFF;
 479:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY((void*)pDst, pData, NumBytesAtOnce);
 480:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     NumBytesAtOnce = NumBytes - Rem;
 481:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pDst = pRing->pBuffer + SEGGER_RTT_UNCACHED_OFF;
 482:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     SEGGER_RTT_MEMCPY((void*)pDst, pData + Rem, NumBytesAtOnce);
 483:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     RTT__DMB();                     // Force data write to be complete before writing the <WrOff>, 
 484:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****     pRing->WrOff = NumBytesAtOnce;
 485:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c **** #endif
 486:Middlewares/Third_Party/SEGGER/RTT/SEGGER_RTT.c ****   }
