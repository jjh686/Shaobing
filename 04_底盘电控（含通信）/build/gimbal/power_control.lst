 142:modules/motor/power_control.c **** {
 143:modules/motor/power_control.c ****     // 这里对can instance的id进行了强制转换,从而获得电机的instance实例地址
 144:modules/motor/power_control.c ****     // _instance指针指向的id是对应电机instance的地址,通过强制转换为电机instan
 145:modules/motor/power_control.c ****     uint8_t *rxbuff = _instance->rx_buff;
 146:modules/motor/power_control.c ****     DJIMotorInstance *motor = (DJIMotorInstance *)_instance->id;
 147:modules/motor/power_control.c ****     DJI_Motor_Measure_s *measure = &motor->measure; // measure要多次使用,保存指针减小访
 148:modules/motor/power_control.c **** 
 149:modules/motor/power_control.c ****     DaemonReload(motor->daemon);
 150:modules/motor/power_control.c ****     motor->dt = DWT_GetDeltaT(&motor->feed_cnt);
 151:modules/motor/power_control.c **** 
 152:modules/motor/power_control.c ****     // 解析数据并对电流和速度进行滤波,电机的反馈报文具体格式见电机说�
 153:modules/motor/power_control.c ****     measure->last_ecd = measure->ecd;
 154:modules/motor/power_control.c ****     measure->ecd = ((uint16_t)rxbuff[0]) << 8 | rxbuff[1];
 155:modules/motor/power_control.c ****     measure->angle_single_round = ECD_ANGLE_COEF_DJI * (float)measure->ecd;
 156:modules/motor/power_control.c ****     measure->speed_aps = (1.0f - SPEED_SMOOTH_COEF) * measure->speed_aps +
 157:modules/motor/power_control.c ****                          RPM_2_ANGLE_PER_SEC * SPEED_SMOOTH_COEF * (float)((int16_t)(rxbuff[2] << 8
 158:modules/motor/power_control.c ****     measure->real_current = (1.0f - CURRENT_SMOOTH_COEF) * measure->real_current +
 159:modules/motor/power_control.c ****                             CURRENT_SMOOTH_COEF * (float)((int16_t)(rxbuff[4] << 8 | rxbuff[5]));
 160:modules/motor/power_control.c ****     measure->temperature = rxbuff[6];
 161:modules/motor/power_control.c **** 
 162:modules/motor/power_control.c ****     // 多圈角度计算,前提是假设两次采样间电机转过的角度小于180°,自己画�
 163:modules/motor/power_control.c ****     if (measure->ecd - measure->last_ecd > 4096)
 164:modules/motor/power_control.c ****         measure->total_round--;
 165:modules/motor/power_control.c ****     else if (measure->ecd - measure->last_ecd < -4096)
 166:modules/motor/power_control.c ****         measure->total_round++;
 167:modules/motor/power_control.c ****     measure->total_angle = measure->total_round * 360 + measure->angle_single_round;
