{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "DiPan_Board: build chassis",
      "type": "shell",
      "command": "bash",
      "args": [
        "${workspaceFolder}/./tools/build_chassis.sh"
      ],
      "windows": {
        "command": "powershell",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}/./tools/build_chassis.ps1"
        ]
      },
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/./tools/build_chassis.sh"
        ]
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "DiPan_Board: host communication tests",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/./tools/test.sh"
      ],
      "problemMatcher": []
    }
  ]
}
