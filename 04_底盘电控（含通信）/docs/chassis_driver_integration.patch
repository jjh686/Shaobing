+{
+    float v[3]={vx,vy,wz};
+    for(unsigned i=0;i<3;i++) {
+        /* Commands round toward zero so quantization cannot increase speed. */
+        int32_t q=(int32_t)(feedback?roundf(v[i]*1000.0f):truncf(v[i]*1000.0f));
+        w16(p+2*i,(uint16_t)q);
