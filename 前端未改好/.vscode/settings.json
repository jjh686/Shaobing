{
    // ===== cortex-debug 插件(调试必需)=====
    // 工具链 bin 目录,里面有 arm-none-eabi-gcc/gdb/objcopy 等
    "cortex-debug.armToolchainPath": "/usr/bin",
    "cortex-debug.armToolchainPath.windows": "D:\\msys64\\ucrt64\\bin",
    // MSYS2 的 ARM 工具链包不含 gdb,这里用自带全部目标的 gdb-multiarch 代替 arm-none-eabi-gdb
    "cortex-debug.gdbPath": "/usr/bin/gdb-multiarch",
    "cortex-debug.gdbPath.windows": "D:\\msys64\\ucrt64\\bin\\gdb-multiarch.exe",
    // 当前调试器为 DAPLink(CMSIS-DAP),由 openocd 连接
    "cortex-debug.openocdPath": "/usr/bin/openocd",
    "cortex-debug.openocdPath.windows": "D:\\msys64\\ucrt64\\bin\\openocd.exe",
    // 已停用 J-Link;若改回 JLink 调试,取消注释并填写 JLink 安装目录
    // "cortex-debug.JLinkGDBServerPath": "C:\\Program Files\\SEGGER\\JLink\\JLinkGDBServerCL.exe",

    // ===== Makefile Tools 插件(代码高亮/补全)=====
    "makefile.makePath": "make",

    // ===== 集成 MSYS2 UCRT64 终端 =====
    // 用它可以避免与系统其他工具链冲突,且支持 ls/rm/find 等命令
    "terminal.integrated.profiles.windows": {
        "msys2-ucrt64": {
            "path": "cmd.exe",
            "args": [
                "/c",
                "D:\\msys64\\msys2_shell.cmd -defterm -ucrt64 -no-start -here"
            ]
        }
    },

    "files.associations": {
        "stm32f4xx_hal_def.h": "c",
        "bsp_usb.h": "c",
        "usb_device.h": "c",
        "usbd_cdc.h": "c",
        "usbd_conf.h": "c",
        "usbd_desc.h": "c",
        "usbd_cdc_if.h": "c",
        "chassis.h": "c",
        "remote_control.h": "c",
        "arm_math.h": "c",
        "can_comm.h": "c",
        "dji_motor.h": "c",
        "bsp_log.h": "c"
    }
}
