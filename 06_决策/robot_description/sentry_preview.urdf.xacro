<?xml version="1.0"?>
<robot name="rm_sentry_preview" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- 离线几何预览模型。导航与定位 TF 由仿真或定位节点提供。 -->
  <xacro:arg name="model_yaml" default="offline_geometry.yaml"/>
  <xacro:property name="model" value="${xacro.load_yaml('$(arg model_yaml)')}"/>

  <xacro:macro name="box_link" params="name size mass center color">
    <link name="${name}">
      <visual>
        <origin xyz="${center[0]} ${center[1]} ${center[2]}"/>
        <geometry><box size="${size[0]} ${size[1]} ${size[2]}"/></geometry>
        <material name="${name}_color"><color rgba="${color}"/></material>
      </visual>
      <collision>
        <origin xyz="${center[0]} ${center[1]} ${center[2]}"/>
        <geometry><box size="${size[0]} ${size[1]} ${size[2]}"/></geometry>
      </collision>
      <inertial>
        <origin xyz="${center[0]} ${center[1]} ${center[2]}"/>
        <mass value="${mass}"/>
        <inertia ixx="${mass * (size[1]**2 + size[2]**2) / 12}"
                 iyy="${mass * (size[0]**2 + size[2]**2) / 12}"
                 izz="${mass * (size[0]**2 + size[1]**2) / 12}"
                 ixy="0" ixz="0" iyz="0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="fixed_mount" params="child parent xyz rpy">
    <joint name="${child}_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${xyz[0]} ${xyz[1]} ${xyz[2]}" rpy="${rpy[0]} ${rpy[1]} ${rpy[2]}"/>
    </joint>
  </xacro:macro>

  <link name="base_footprint"/>
  <xacro:box_link name="chassis" size="${model.chassis.size_m}"
                  center="${model.chassis.center_m}" mass="${model.chassis.mass_kg}" color="0.17 0.31 0.45 1"/>
  <xacro:fixed_mount child="chassis" parent="base_footprint" xyz="${[0, 0, 0]}" rpy="${[0, 0, 0]}"/>

  <xacro:box_link name="gimbal_yaw" size="${model.yaw_mount.size_m}"
                  center="${[0, 0, 0]}" mass="${model.yaw_mount.mass_kg}" color="0.36 0.52 0.61 1"/>
  <joint name="gimbal_yaw_joint" type="continuous">
    <parent link="base_footprint"/>
    <child link="gimbal_yaw"/>
    <origin xyz="${model.yaw_mount.xyz_m[0]} ${model.yaw_mount.xyz_m[1]} ${model.yaw_mount.xyz_m[2]}"/>
    <axis xyz="0 0 1"/>
  </joint>

  <xacro:box_link name="gimbal_pitch" size="${model.pitch_mount.size_m}"
                  center="${[0, 0, 0]}" mass="${model.pitch_mount.mass_kg}" color="0.42 0.59 0.67 1"/>
  <joint name="gimbal_pitch_joint" type="revolute">
    <parent link="gimbal_yaw"/>
    <child link="gimbal_pitch"/>
    <origin xyz="${model.pitch_mount.xyz_m[0]} ${model.pitch_mount.xyz_m[1]} ${model.pitch_mount.xyz_m[2]}"/>
    <axis xyz="0 1 0"/>
    <limit lower="${model.pitch_mount.limits_rad[0]}" upper="${model.pitch_mount.limits_rad[1]}" effort="1" velocity="1"/>
  </joint>

  <link name="front_mid360"/>
  <xacro:fixed_mount child="front_mid360" parent="base_footprint" xyz="${model.lidar.xyz_m}" rpy="${model.lidar.rpy_rad}"/>
  <link name="front_camera"/>
  <xacro:fixed_mount child="front_camera" parent="gimbal_pitch" xyz="${model.camera.xyz_m}" rpy="${model.camera.rpy_rad}"/>
  <link name="front_camera_optical"/>
  <xacro:fixed_mount child="front_camera_optical" parent="front_camera" xyz="${[0, 0, 0]}" rpy="${[-pi/2, 0, -pi/2]}"/>

  <!-- Gazebo 仅加载静态几何，关节与传感器话题留给仿真平台。 -->
  <gazebo><static>true</static></gazebo>
</robot>
