{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build task",
            "detail": "编译固件，不烧录；F5 调试前自动执行",
            "type": "process",
            "command": "make",
            "args": [
                "-j16",
                "all"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "command": "powershell",
                "args": [
                    "-NoProfile",
                    "-ExecutionPolicy",
                    "Bypass",
                    "-File",
                    "${workspaceFolder}/tools/build.ps1"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "linux": {
                "command": "make",
                "args": [
                    "-j16",
                    "all"
                ],
                "options": {
                    "cwd": "${workspaceFolder}"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "clean rebuild",
            "detail": "清理并重新编译全部固件",
            "type": "process",
            "command": "make",
            "args": [
                "rebuild"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "flash dap",
            "detail": "DAPLink：编译、烧录、校验并复位运行（Ctrl+Shift+B）",
            "type": "process",
            "command": "make",
            "args": [
                "download_dap"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "check dap",
            "detail": "检查 DAPLink 与目标芯片连接，不烧录、不复位",
            "type": "process",
            "command": "make",
            "args": [
                "probe_dap"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "watch flash",
            "detail": "仅适用于 Windows / PowerShell：监听源码并自动编译和烧录",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .vscode/watch_flash.ps1",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "watch build only",
            "detail": "仅适用于 Windows / PowerShell：监听源码并自动编译",
            "type": "shell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .vscode/watch_flash.ps1 -NoFlash",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "setup daplink",
            "detail": "Ubuntu：安装 ARM 工具链、GDB、OpenOCD 和 DAPLink USB 权限；按提示输入 sudo 密码",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/setup_daplink_ubuntu.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "verify daplink",
            "detail": "编译、检查调试符号并识别 DAPLink/芯片；不烧录、不复位",
            "type": "process",
            "command": "bash",
            "args": [
                "${workspaceFolder}/tools/verify_daplink.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "clear": true
            }
        }
    ]
}
